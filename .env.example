# ========== Локальный запуск (два терминала) ==========
# 1) Бэкенд: скопируйте в backend/.env
# 2) Фронтенд: по умолчанию подключается к http://localhost:3000; при другом порте создайте frontend/.env

# --- backend/.env ---
PORT=3000
JWT_SECRET=change-me-in-production-min-32-chars
SQLITE_PATH=./data/spearfishing.db
ADMIN_EMAIL=admin@spearfishing.by
ADMIN_PASSWORD=admin123

# --- frontend/.env (опционально, если бэкенд не на :3000) ---
# VITE_API_URL=http://localhost:3000
